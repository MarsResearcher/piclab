import { useCallback, useEffect, useRef, useState, type DragEvent } from 'react';
import { CanvasManager, type ViewTransform } from '../core/canvasManager';
import {
  asExperimentResult,
  defaultsFromParams,
  type Experiment,
  type ParamValues,
  type Probe,
} from '../core/experiment';
import { loadPlaygrounds, loadPrinciples } from '../core/experimentRegistry';
import { imageState } from '../core/imageState';
import { FluidStir } from '../core/fluidStir';
import { loadSessionSnapshot, scheduleSessionSave } from '../core/session';
import { getLibraryItem, listLibrary } from '../core/library';
import type { AppMode } from '../core/appMode';
import { Toolbar } from './toolbar';
import { CropOverlay } from './CropOverlay';
import { ExportPanel } from './ExportPanel';
import { BatchExportPanel } from './BatchExportPanel';
import { HistoryStrip } from './HistoryStrip';
import { MakePanel, type MakeTool } from './MakePanel';
import { PlayPanel } from './PlayPanel';
import { LearnPanel } from './LearnPanel';
import { LibraryDrawer } from './LibraryDrawer';
import { TextEditorOverlay } from './TextEditorOverlay';
import { applyCrop, type CropRect } from '../tools/crop';
import { flipHorizontal, rotate90 } from '../tools/transform';
import {
  applyAdjust,
  DEFAULT_ADJUST,
  isNeutralAdjust,
  type AdjustParams,
} from '../tools/adjust';
import {
  DEFAULT_TEXT,
  renderTextOverlay,
  textHitTest,
  type TextStyle,
} from '../tools/textOverlay';

function cloneImageData(source: ImageData): ImageData {
  return new ImageData(new Uint8ClampedArray(source.data), source.width, source.height);
}

const STIR_ID = 'stirPool';

export function App() {
  const canvasRef = useRef<HTMLCanvasElement>(null);
  const auxCanvasRef = useRef<HTMLCanvasElement | null>(null);
  const managerRef = useRef<CanvasManager | null>(null);
  const baseRef = useRef<ImageData | null>(null);
  const previewTimer = useRef<number | null>(null);
  const comparingRef = useRef(false);

  const [appMode, setAppMode] = useState<AppMode>('make');
  const [playgrounds, setPlaygrounds] = useState<Experiment[]>([]);
  const [principles, setPrinciples] = useState<Experiment[]>([]);
  const [active, setActive] = useState<Experiment | null>(null);
  const [params, setParams] = useState<ParamValues>({});
  const [busy, setBusy] = useState(false);
  const [status, setStatus] = useState('载入图片，开始制作');
  const [narration, setNarration] = useState('');
  const [auxLabel, setAuxLabel] = useState('原理视窗');
  const [probeNotice, setProbeNotice] = useState('');
  const [activeProbeId, setActiveProbeId] = useState<string | null>(null);
  const [showFineTune, setShowFineTune] = useState(false);
  const [hasImage, setHasImage] = useState(false);
  const [historyTick, setHistoryTick] = useState(0);
  const [comparing, setComparing] = useState(false);
  const [currentLibraryId, setCurrentLibraryId] = useState<string | null>(null);
  const [libraryOpen, setLibraryOpen] = useState(false);
  const [libraryCount, setLibraryCount] = useState(0);
  const [cropping, setCropping] = useState(false);
  const [exportOpen, setExportOpen] = useState(false);
  const [batchOpen, setBatchOpen] = useState(false);
  const [viewTransform, setViewTransform] = useState<ViewTransform>({
    scale: 1,
    offsetX: 0,
    offsetY: 0,
  });
  const [adjust, setAdjust] = useState<AdjustParams>({ ...DEFAULT_ADJUST });
  const [textStyle, setTextStyle] = useState<TextStyle>({ ...DEFAULT_TEXT });
  const [makeTool, setMakeTool] = useState<MakeTool>('adjust');
  const [textEditing, setTextEditing] = useState(false);

  // Live make preview — refs avoid React re-render storms while dragging text
  const adjustRef = useRef(adjust);
  const textStyleRef = useRef(textStyle);
  const makePreviewRaf = useRef<number | null>(null);
  const makeLiveRef = useRef(false);
  adjustRef.current = adjust;
  textStyleRef.current = textStyle;

  // Play-mode accumulating buffer (brush / freq) — never stamp from original each frame
  const playWorkRef = useRef<ImageData | null>(null);

  const stirRef = useRef<FluidStir | null>(null);
  const stirPointerRef = useRef<{ x: number; y: number } | null>(null);
  const stirRafRef = useRef<number | null>(null);
  const [stirRadius, setStirRadius] = useState(60);
  const [stirStrength, setStirStrength] = useState(0.9);
  const [stirViscosity, setStirViscosity] = useState(0.86);

  const isStir = appMode === 'play' && active?.id === STIR_ID;
  const inMake = appMode === 'make';

  const activeIdRef = useRef<string | null>(null);
  const libraryIdRef = useRef<string | null>(null);
  const appModeRef = useRef(appMode);
  activeIdRef.current = inMake ? null : (active?.id ?? null);
  libraryIdRef.current = currentLibraryId;
  appModeRef.current = appMode;

  const stopStirLoop = useCallback(() => {
    if (stirRafRef.current !== null) {
      cancelAnimationFrame(stirRafRef.current);
      stirRafRef.current = null;
    }
  }, []);

  const discardStir = useCallback(() => {
    stopStirLoop();
    stirPointerRef.current = null;
    stirRef.current = null;
    playWorkRef.current = null;
    if (baseRef.current) {
      imageState.restoreSilent(baseRef.current);
      managerRef.current?.setImageSilent(baseRef.current);
    }
  }, [stopStirLoop]);

  const composeMake = useCallback((base: ImageData): ImageData => {
    let img = base;
    const adj = adjustRef.current;
    const text = textStyleRef.current;
    if (!isNeutralAdjust(adj)) img = applyAdjust(img, adj);
    if (text.content.trim()) img = renderTextOverlay(img, text);
    return img;
  }, []);

  /** Silent RAF preview for make tools — never touches imageState / history thumbs. */
  const scheduleMakePreview = useCallback(() => {
    if (makePreviewRaf.current !== null) return;
    makePreviewRaf.current = requestAnimationFrame(() => {
      makePreviewRaf.current = null;
      const base = baseRef.current;
      const manager = managerRef.current;
      if (!base || !manager || !makeLiveRef.current) return;
      manager.setImageSilent(composeMake(base));
    });
  }, [composeMake]);

  const stirFrame = useCallback(() => {
    const stir = stirRef.current;
    const manager = managerRef.current;
    if (!stir || !manager) {
      stirRafRef.current = null;
      return;
    }
    const img = stir.tick(stirPointerRef.current, {
      radius: stirRadius,
      strength: stirStrength,
      viscosity: stirViscosity,
    });
    manager.setImageSilent(img);
    stirRafRef.current = requestAnimationFrame(stirFrame);
  }, [stirRadius, stirStrength, stirViscosity]);

  const startStirLoop = useCallback(() => {
    stopStirLoop();
    stirRafRef.current = requestAnimationFrame(stirFrame);
  }, [stirFrame, stopStirLoop]);

  const clearAux = useCallback(() => {
    const aux = auxCanvasRef.current;
    if (!aux) return;
    const ctx = aux.getContext('2d');
    if (!ctx) return;
    ctx.clearRect(0, 0, aux.width, aux.height);
    aux.dataset.empty = '1';
  }, []);

  const resetMakeTools = useCallback(() => {
    setAdjust({ ...DEFAULT_ADJUST });
    setTextStyle({ ...DEFAULT_TEXT });
  }, []);

  const selectExperiment = useCallback(
    (exp: Experiment, _restoreBase = true) => {
      stopStirLoop();
      stirPointerRef.current = null;
      stirRef.current = null;

      setActive(exp);
      setNarration(exp.principle);
      setAuxLabel('原理视窗');
      setShowFineTune(false);
      setCropping(false);
      setExportOpen(false);
      setBatchOpen(false);
      clearAux();

      const base = baseRef.current;
      const mode = appModeRef.current;

      if (exp.id === STIR_ID) {
        playWorkRef.current = null;
        setParams(defaultsFromParams(exp.params));
        if (base) {
          imageState.restoreSilent(base);
          stirRef.current = new FluidStir(base);
          // Never fit on select — fit causes view jump / perceived jitter
          managerRef.current?.setImageSilent(stirRef.current.current);
        }
        setStatus('玩法：搅动池水 — 按住拖动水面');
        setActiveProbeId(null);
        setProbeNotice('');
        return;
      }

      if (mode === 'play') {
        // Interactive play: one working buffer, single silent paint — no restore flash
        if (base) {
          playWorkRef.current = cloneImageData(base);
          imageState.restoreSilent(base);
          managerRef.current?.setImageSilent(playWorkRef.current);
        } else {
          playWorkRef.current = null;
        }
      } else {
        // Learn: restore into imageState so probe pipeline can preview
        playWorkRef.current = null;
        if (base) imageState.restore(base);
      }

      const first = exp.probes[0];
      if (first) {
        setParams({ ...defaultsFromParams(exp.params), ...first.params });
        setActiveProbeId(first.id);
        setProbeNotice(first.notice);
        setStatus(`${exp.name} · ${first.label}`);
      } else {
        setParams(defaultsFromParams(exp.params));
        setActiveProbeId(null);
        setProbeNotice(exp.observe[0] ?? '');
        setStatus(`${exp.name}`);
      }
    },
    [clearAux, stopStirLoop],
  );

  const enterMakeMode = useCallback(() => {
    discardStir();
    setActive(null);
    resetMakeTools();
    clearAux();
    setCropping(false);
    setShowFineTune(false);
    setTextEditing(false);
    makeLiveRef.current = true;
    if (baseRef.current) {
      imageState.restoreSilent(baseRef.current);
      managerRef.current?.setImageSilent(baseRef.current);
    }
    setAppMode('make');
    setStatus(hasImage ? '制作模式 — 双击画布加字 · 拖动定位' : '载入图片，开始制作');
    scheduleMakePreview();
  }, [clearAux, discardStir, hasImage, resetMakeTools, scheduleMakePreview]);

  const switchMode = useCallback(
    (mode: AppMode) => {
      if (mode === appMode) return;

      // Leaving make: drop uncommitted tool preview silently
      if (appMode === 'make') {
        makeLiveRef.current = false;
        setTextEditing(false);
        resetMakeTools();
        if (baseRef.current) {
          imageState.restoreSilent(baseRef.current);
          managerRef.current?.setImageSilent(baseRef.current);
        }
      }

      // Leaving play: discard uncured realtime work
      if (appMode === 'play') {
        discardStir();
      }

      setCropping(false);
      setExportOpen(false);
      setBatchOpen(false);

      if (mode === 'make') {
        enterMakeMode();
        return;
      }

      makeLiveRef.current = false;

      if (mode === 'play') {
        appModeRef.current = 'play';
        setAppMode('play');
        const first = playgrounds[0];
        if (first) selectExperiment(first, true);
        else {
          setActive(null);
          setStatus('玩法模式 — 从左侧选择');
        }
        return;
      }

      // learn
      appModeRef.current = 'learn';
      setAppMode('learn');
      playWorkRef.current = null;
      const first = principles[0];
      if (first) {
        if (baseRef.current) imageState.restore(baseRef.current);
        selectExperiment(first, true);
      } else {
        setActive(null);
        setStatus('原理模式 — 从左侧选择');
      }
    },
    [appMode, discardStir, enterMakeMode, playgrounds, principles, resetMakeTools, selectExperiment],
  );

  const refreshLibraryCount = useCallback(async () => {
    try {
      const items = await listLibrary();
      setLibraryCount(items.length);
    } catch {
      setLibraryCount(0);
    }
  }, []);

  useEffect(() => {
    let cancelled = false;
    Promise.all([loadPlaygrounds(), loadPrinciples(), refreshLibraryCount()]).then(
      async ([pg, pr]) => {
        if (cancelled) return;
        setPlaygrounds(pg);
        setPrinciples(pr);

        try {
          const snapshot = await loadSessionSnapshot();
          if (cancelled) return;
          if (snapshot?.imageBlob) {
            await loadImageSource(snapshot.imageBlob, '上次会话', snapshot.libraryId);
            setAppMode('make');
            setActive(null);
            makeLiveRef.current = true;
            setStatus('已恢复上次会话 · 制作模式');
            return;
          }
        } catch {
          // ignore
        }

        setAppMode('make');
        setStatus('载入图片，开始制作');
      },
    );
    return () => {
      cancelled = true;
    };
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, []);

  useEffect(() => {
    const canvas = canvasRef.current;
    if (!canvas) return;
    const manager = new CanvasManager(canvas);
    managerRef.current = manager;

    const ro = new ResizeObserver((entries) => {
      const entry = entries[0];
      if (!entry) return;
      const { width, height } = entry.contentRect;
      manager.resize(width, height);
    });
    const stage = canvas.parentElement;
    if (stage) ro.observe(stage);

    const unsub = imageState.subscribe((event) => {
      // Don't let imageState overwrite live make/stir canvases
      if (!comparingRef.current && !stirRef.current && !makeLiveRef.current) {
        manager.setImage(imageState.imageData);
      }
      setHasImage(!!imageState.imageData);
      // Only rebuild history thumbs on real history changes — never on preview
      if (event.historyChanged) {
        setHistoryTick((t) => t + 1);
      }
      if (event.historyChanged) {
        scheduleSessionSave(imageState.imageData, activeIdRef.current, libraryIdRef.current);
      }
    });
    const unsubView = manager.subscribe(() => {
      setViewTransform(manager.view);
    });
    setViewTransform(manager.view);

    return () => {
      ro.disconnect();
      unsub();
      unsubView();
      managerRef.current = null;
    };
  }, []);

  useEffect(() => {
    const setCompare = (on: boolean) => {
      if (appMode !== 'learn') return;
      comparingRef.current = on;
      setComparing(on);
      const manager = managerRef.current;
      if (!manager) return;
      if (on && baseRef.current) manager.setImage(baseRef.current);
      else manager.setImage(imageState.imageData);
    };

    const down = (e: KeyboardEvent) => {
      if (e.code === 'Space' && !e.repeat && !(e.target instanceof HTMLInputElement)) {
        e.preventDefault();
        setCompare(true);
      }
    };
    const up = (e: KeyboardEvent) => {
      if (e.code === 'Space') {
        e.preventDefault();
        setCompare(false);
      }
    };
    window.addEventListener('keydown', down);
    window.addEventListener('keyup', up);
    return () => {
      window.removeEventListener('keydown', down);
      window.removeEventListener('keyup', up);
    };
  }, [appMode]);

  const drawAux = (image: ImageData) => {
    const aux = auxCanvasRef.current;
    if (!aux) return;
    aux.width = image.width;
    aux.height = image.height;
    const ctx = aux.getContext('2d');
    if (!ctx) return;
    ctx.putImageData(image, 0, 0);
    delete aux.dataset.empty;
  };

  const runExperiment = useCallback(
    async (mode: 'preview' | 'commit') => {
      if (!active || !baseRef.current || appMode !== 'learn') return;
      if (active.id === STIR_ID) return;
      setBusy(true);
      const t0 = performance.now();
      try {
        const raw = await active.apply(baseRef.current, params);
        const result = asExperimentResult(raw);
        if (mode === 'commit') {
          imageState.commit(result.imageData, active.id);
          baseRef.current = imageState.getSnapshot();
          setStatus(`已固化 · ${active.name} · ${(performance.now() - t0).toFixed(0)} ms`);
        } else {
          imageState.preview(result.imageData);
          setStatus(`观察中 · ${active.name} · ${(performance.now() - t0).toFixed(0)} ms`);
        }
        if (typeof result.meta?.narration === 'string') setNarration(result.meta.narration);
        if (typeof result.meta?.auxLabel === 'string') setAuxLabel(result.meta.auxLabel);
        if (result.auxImageData) drawAux(result.auxImageData);
        else clearAux();
      } catch (err) {
        const msg = err instanceof Error ? err.message : String(err);
        setStatus(`错误: ${msg}`);
      } finally {
        setBusy(false);
      }
    },
    [active, params, clearAux, appMode],
  );

  // Learn-mode experiment preview
  useEffect(() => {
    if (appMode !== 'learn' || !active || !baseRef.current) return;
    if (active.id === STIR_ID) return;
    const delay = active.realtime ? 40 : 80;
    if (previewTimer.current) window.clearTimeout(previewTimer.current);
    previewTimer.current = window.setTimeout(() => {
      void runExperiment('preview');
    }, delay);
    return () => {
      if (previewTimer.current) window.clearTimeout(previewTimer.current);
    };
  }, [params, active, runExperiment, appMode]);

  // Make-mode: silent live preview (no imageState.preview → no history rebuild)
  useEffect(() => {
    if (!inMake || !hasImage) return;
    makeLiveRef.current = true;
    scheduleMakePreview();
  }, [adjust, textStyle, inMake, hasImage, scheduleMakePreview]);

  const commitTools = (label: string) => {
    const base = baseRef.current;
    if (!base) return;
    const composed = composeMake(base);
    imageState.commit(composed, label);
    baseRef.current = imageState.getSnapshot();
    resetMakeTools();
    makeLiveRef.current = true;
    managerRef.current?.setImageSilent(baseRef.current ?? composed);
    setStatus(`已固化 · ${label}`);
  };

  const startTextEdit = () => {
    setMakeTool('text');
    setTextEditing(true);
    if (!textStyleRef.current.content.trim()) {
      const next = { ...textStyleRef.current, content: '双击编辑' };
      textStyleRef.current = next;
      setTextStyle(next);
    }
    scheduleMakePreview();
  };

  const onParamChange = (key: string, value: unknown) => {
    setActiveProbeId(null);
    setParams((prev) => ({ ...prev, [key]: value }));
  };

  // Canvas interaction by mode
  useEffect(() => {
    const manager = managerRef.current;
    if (!manager) return;

    // Make: drag text via refs + silent RAF (no setState per move = no flicker)
    if (inMake && hasImage) {
      let draggingText = false;
      manager.setInteraction({
        onPaint: (event, info) => {
          const base = baseRef.current;
          if (!base) return false;
          const text = textStyleRef.current;
          if (!text.content.trim()) return false;

          if (event.type === 'pointerdown') {
            draggingText = textHitTest(base, text, info.x, info.y) || textEditing;
            if (!draggingText) return false;
          }
          if (!draggingText && !(event.buttons & 1)) return false;
          if (!draggingText) return false;

          textStyleRef.current = {
            ...textStyleRef.current,
            x: info.x / base.width,
            y: info.y / base.height,
          };
          scheduleMakePreview();
          return true;
        },
        onDblClick: (_event, info) => {
          const base = baseRef.current;
          if (!base) return;
          // Place / edit text at double-click point
          const next: TextStyle = {
            ...textStyleRef.current,
            content: textStyleRef.current.content.trim() || '双击编辑',
            x: info.x / base.width,
            y: info.y / base.height,
          };
          textStyleRef.current = next;
          setTextStyle(next);
          setMakeTool('text');
          setTextEditing(true);
          scheduleMakePreview();
        },
      });
      const syncText = () => {
        if (draggingText) {
          draggingText = false;
          setTextStyle({ ...textStyleRef.current });
        }
      };
      window.addEventListener('pointerup', syncText);
      return () => {
        manager.setInteraction(null);
        window.removeEventListener('pointerup', syncText);
      };
    }

    if (appMode === 'play' && active?.id === STIR_ID && hasImage) {
      manager.setInteraction({
        onPaint: (_event, info) => {
          stirPointerRef.current = { x: info.x, y: info.y };
          startStirLoop();
          return true;
        },
      });
      const clearPointer = () => {
        stirPointerRef.current = null;
      };
      window.addEventListener('pointerup', clearPointer);
      window.addEventListener('pointercancel', clearPointer);
      return () => {
        manager.setInteraction(null);
        window.removeEventListener('pointerup', clearPointer);
        window.removeEventListener('pointercancel', clearPointer);
      };
    }

    // Play brush/freq: stamp onto playWorkRef, silent draw — never re-apply from base
    if (appMode === 'play' && active?.interaction?.onPointer && hasImage) {
      let stampBusy = false;
      manager.setInteraction({
        onPaint: (event, info) => {
          if (!active.interaction?.onPointer) return false;
          const work = playWorkRef.current;
          if (!work) return false;

          // Collect stamp params without React setState storms
          const stampParams = { ...params };
          active.interaction.onPointer(event, info, {
            params: stampParams,
            setParam: (key, value) => {
              stampParams[key] = value;
            },
          });

          if (stampBusy) return true;
          stampBusy = true;
          void (async () => {
            try {
              const raw = await active.apply(work, stampParams);
              const result = asExperimentResult(raw);
              playWorkRef.current = result.imageData;
              managerRef.current?.setImageSilent(result.imageData);
            } finally {
              stampBusy = false;
            }
          })();
          return true;
        },
      });
      return () => manager.setInteraction(null);
    }

    if (appMode === 'learn' && active?.interaction?.onPointer && hasImage) {
      manager.setInteraction({
        onPaint: (event, info) => {
          active.interaction!.onPointer!(event, info, {
            params,
            setParam: (key, value) => setParams((prev) => ({ ...prev, [key]: value })),
          });
          return true;
        },
      });
      return () => manager.setInteraction(null);
    }

    manager.setInteraction(null);
    return () => manager.setInteraction(null);
  }, [
    active,
    params,
    hasImage,
    startStirLoop,
    inMake,
    appMode,
    textEditing,
    scheduleMakePreview,
  ]);

  const applyProbe = (probe: Probe) => {
    if (!active) return;
    const next = { ...defaultsFromParams(active.params), ...probe.params };
    setParams(next);
    setActiveProbeId(probe.id);
    setProbeNotice(probe.notice);
    setStatus(`探测：${probe.label}`);
  };

  const loadImageSource = async (
    source: ImageBitmapSource,
    label: string,
    libraryId: string | null = null,
  ) => {
    const bitmap = await createImageBitmap(source);
    const c = document.createElement('canvas');
    c.width = bitmap.width;
    c.height = bitmap.height;
    const ctx = c.getContext('2d');
    if (!ctx) return;
    ctx.drawImage(bitmap, 0, 0);
    const data = ctx.getImageData(0, 0, c.width, c.height);
    imageState.load(data, label);
    baseRef.current = imageState.getSnapshot();
    managerRef.current?.setImage(imageState.imageData, true);
    clearAux();
    resetMakeTools();
    setCurrentLibraryId(libraryId);

    if (isStir) {
      const base = baseRef.current;
      if (base) {
        stirRef.current = new FluidStir(base);
        managerRef.current?.setImage(stirRef.current.current, true);
      }
      setStatus(`已载入 ${label} · ${data.width}×${data.height} — 按住拖动水面`);
      return;
    }

    if (appMode === 'learn' && active?.probes[0]) {
      setStatus(`已载入 ${label} · ${data.width}×${data.height}`);
      applyProbe(active.probes[0]);
      return;
    }

    setStatus(`已载入 ${label} · ${data.width}×${data.height}`);
  };

  const pickFromLibrary = (blob: Blob, name: string, id: string) => {
    void loadImageSource(blob, name, id);
    void refreshLibraryCount();
  };

  const getCurrentImage = (): ImageData | null => {
    if (isStir && stirRef.current) return stirRef.current.current;
    if (appMode === 'play' && playWorkRef.current) return playWorkRef.current;
    if (inMake && baseRef.current && makeLiveRef.current) {
      return composeMake(baseRef.current);
    }
    return imageState.imageData;
  };

  const loadFile = async (file: File) => {
    await loadImageSource(file, file.name);
  };

  const onDrop = (e: DragEvent) => {
    e.preventDefault();
    const libraryId = e.dataTransfer.getData('application/x-piclab-library');
    if (libraryId) {
      void (async () => {
        const item = await getLibraryItem(libraryId);
        if (item) await loadImageSource(item.blob, item.name, item.id);
      })();
      return;
    }
    const file = e.dataTransfer.files[0];
    if (file && file.type.startsWith('image/')) void loadFile(file);
  };

  const loadSample = async () => {
    try {
      const res = await fetch('/samples/lab-sample.jpg');
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      const blob = await res.blob();
      await loadImageSource(blob, 'lab-sample.jpg');
    } catch (err) {
      const msg = err instanceof Error ? err.message : String(err);
      setStatus(`样本载入失败: ${msg}`);
    }
  };

  const commitTransformed = (next: ImageData, label: string) => {
    imageState.commit(next, label);
    baseRef.current = imageState.getSnapshot();
    managerRef.current?.setImage(imageState.imageData, true);
    resetMakeTools();
    setStatus(`${label} · ${next.width}×${next.height}`);
  };

  const applyCropRect = (rect: CropRect) => {
    const img = getCurrentImage();
    if (!img) return;
    commitTransformed(applyCrop(img, rect), '已裁剪');
    setCropping(false);
  };

  const quickTransform = (kind: 'rot90' | 'flipH') => {
    const img = getCurrentImage();
    if (!img) return;
    if (kind === 'rot90') commitTransformed(rotate90(img, 1), '旋转 90°');
    else commitTransformed(flipHorizontal(img), '水平翻转');
  };

  const resetStir = () => {
    const base = baseRef.current;
    if (base) {
      stirRef.current = new FluidStir(base);
      managerRef.current?.setImage(stirRef.current.current, true);
    }
  };

  const commitStir = () => {
    if (!stirRef.current) return;
    const img = stirRef.current.current;
    imageState.commit(img, '搅动水面');
    baseRef.current = imageState.getSnapshot();
    stirRef.current = new FluidStir(baseRef.current!);
    managerRef.current?.setImage(stirRef.current.current, true);
    setStatus('已固化水面到历史');
  };

  const setCompareHold = (on: boolean) => {
    if (appMode !== 'learn') return;
    comparingRef.current = on;
    setComparing(on);
    const manager = managerRef.current;
    if (!manager) return;
    if (on && baseRef.current) manager.setImage(baseRef.current);
    else manager.setImage(imageState.imageData);
  };

  const interactionHint =
    inMake && hasImage && !cropping
      ? textEditing || textStyle.content.trim()
        ? '✦ 拖动文字定位 · 双击画布编辑'
        : '✦ 双击画布添加文字'
      : appMode === 'play' && active?.interaction && hasImage && !cropping
        ? active.interaction.hint
        : null;

  const panelTitle =
    appMode === 'make' ? '制作' : active?.name ?? (appMode === 'play' ? '玩法' : '原理');

  const panelTag =
    appMode === 'make' ? 'make' : appMode === 'play' ? 'play' : 'lab';

  void historyTick;

  return (
    <div className="lab" onDragOver={(e) => e.preventDefault()} onDrop={onDrop}>
      <Toolbar
        mode={appMode}
        onModeChange={switchMode}
        playgrounds={playgrounds}
        principles={principles}
        activeId={active?.id ?? null}
        onSelect={(id) => {
          const list = appMode === 'play' ? playgrounds : principles;
          const exp = list.find((e) => e.id === id);
          if (exp) selectExperiment(exp);
        }}
        onOpenLibrary={() => {
          setLibraryOpen(true);
          void refreshLibraryCount();
        }}
        libraryCount={libraryCount}
      />

      <main className="stage">
        <canvas ref={canvasRef} className="main-canvas" />
        {cropping && hasImage && inMake && (
          <CropOverlay
            imageWidth={getCurrentImage()?.width ?? 0}
            imageHeight={getCurrentImage()?.height ?? 0}
            view={viewTransform}
            onApply={applyCropRect}
            onCancel={() => setCropping(false)}
          />
        )}
        {!hasImage && (
          <div className="empty-state">
            <p className="empty-brand">PicLab</p>
            <p>载入图片，开始制作</p>
            <button type="button" className="btn primary" onClick={() => void loadSample()}>
              载入示例图片
            </button>
            <button type="button" className="btn" onClick={() => setLibraryOpen(true)}>
              打开图库
            </button>
          </div>
        )}
        {comparing && <div className="compare-badge glass">对照原图</div>}
        {interactionHint && <div className="interaction-hint glass">{interactionHint}</div>}
        <div className="stage-hud glass">
          <span>{status}</span>
          {busy && <span className="pulse">computing</span>}
        </div>
        <HistoryStrip
          tick={historyTick}
          onJump={(index) => {
            if (imageState.jumpTo(index)) {
              baseRef.current = imageState.getSnapshot();
              const base = baseRef.current;
              if (isStir && base) {
                stirRef.current = new FluidStir(base);
                managerRef.current?.setImageSilent(stirRef.current.current);
              } else if (appMode === 'play' && base) {
                playWorkRef.current = cloneImageData(base);
                managerRef.current?.setImageSilent(playWorkRef.current);
              } else if (inMake && base) {
                resetMakeTools();
                makeLiveRef.current = true;
                managerRef.current?.setImageSilent(base);
              }
              clearAux();
              setStatus(`跳转到历史 #${index}`);
            }
          }}
        />
        {inMake && (
          <TextEditorOverlay
            open={textEditing}
            style={textStyle}
            view={viewTransform}
            imageWidth={baseRef.current?.width ?? 0}
            imageHeight={baseRef.current?.height ?? 0}
            onChange={(next) => {
              textStyleRef.current = next;
              setTextStyle(next);
            }}
            onClose={() => setTextEditing(false)}
            onCommit={() => commitTools('加字')}
          />
        )}
      </main>

      <aside className="panel right glass">
        <header className="panel-header">
          <span>{panelTitle}</span>
          <span className="tag">{panelTag}</span>
        </header>

        {appMode === 'make' && (
          <MakePanel
            hasImage={hasImage}
            busy={busy}
            activeTool={makeTool}
            onToolChange={setMakeTool}
            adjust={adjust}
            onAdjustChange={(next) => {
              adjustRef.current = next;
              setAdjust(next);
            }}
            onAdjustCommit={() => commitTools('调色')}
            textStyle={textStyle}
            onTextChange={(next) => {
              textStyleRef.current = next;
              setTextStyle(next);
            }}
            onTextCommit={() => commitTools('加字')}
            onStartTextEdit={startTextEdit}
            getCurrentImage={getCurrentImage}
            onStatus={setStatus}
            onCrop={() => {
              setExportOpen(false);
              setBatchOpen(false);
              setCropping(true);
              setMakeTool('crop');
            }}
            onExport={() => {
              setCropping(false);
              setBatchOpen(false);
              setExportOpen(true);
              setMakeTool('export');
            }}
            onBatch={() => {
              setCropping(false);
              setExportOpen(false);
              setBatchOpen((v) => !v);
            }}
            onRotate={() => quickTransform('rot90')}
            onFlip={() => quickTransform('flipH')}
          />
        )}

        {appMode === 'play' && (
          <PlayPanel
            active={active}
            hasImage={hasImage}
            isStir={isStir}
            stirRadius={stirRadius}
            stirStrength={stirStrength}
            stirViscosity={stirViscosity}
            onStirRadius={setStirRadius}
            onStirStrength={setStirStrength}
            onStirViscosity={setStirViscosity}
            onResetStir={resetStir}
            onCommitStir={commitStir}
            canCommitPlay={!!active && active.id !== STIR_ID && !!playWorkRef.current && !busy}
            onCommitPlay={() => {
              if (!active || active.id === STIR_ID || !playWorkRef.current) return;
              imageState.commit(playWorkRef.current, active.id);
              baseRef.current = imageState.getSnapshot();
              playWorkRef.current = baseRef.current
                ? cloneImageData(baseRef.current)
                : null;
              setStatus(`已固化 · ${active.name}`);
            }}
          />
        )}

        {appMode === 'learn' && (
          <LearnPanel
            active={active}
            hasImage={hasImage}
            busy={busy}
            narration={narration}
            auxLabel={auxLabel}
            probeNotice={probeNotice}
            activeProbeId={activeProbeId}
            showFineTune={showFineTune}
            params={params}
            auxCanvasRef={auxCanvasRef}
            onApplyProbe={applyProbe}
            onParamChange={onParamChange}
            onToggleFineTune={() => setShowFineTune((v) => !v)}
            onCompareHold={setCompareHold}
            onCommit={() => void runExperiment('commit')}
          />
        )}

        <div className="actions shared-actions">
          <button
            type="button"
            className="btn"
            disabled={!imageState.canUndo || busy || isStir}
            onClick={() => {
              imageState.undo();
              baseRef.current = imageState.getSnapshot();
              clearAux();
              resetMakeTools();
              setStatus('撤销');
            }}
          >
            撤销
          </button>
          <button
            type="button"
            className="btn"
            disabled={!imageState.canRedo || busy || isStir}
            onClick={() => {
              imageState.redo();
              baseRef.current = imageState.getSnapshot();
              clearAux();
              resetMakeTools();
              setStatus('重做');
            }}
          >
            重做
          </button>
          <label className="btn file-btn">
            打开图片
            <input
              type="file"
              accept="image/*"
              hidden
              onChange={(e) => {
                const f = e.target.files?.[0];
                if (f) void loadFile(f);
              }}
            />
          </label>
          {!inMake && (
            <button
              type="button"
              className="btn"
              disabled={!hasImage}
              onClick={() => {
                setCropping(false);
                setBatchOpen(false);
                setExportOpen(true);
              }}
            >
              导出
            </button>
          )}
          <button
            type="button"
            className="btn"
            disabled={!hasImage}
            onClick={() => managerRef.current?.resetView()}
          >
            适应
          </button>
        </div>

        {exportOpen && (
          <ExportPanel imageData={getCurrentImage()} onClose={() => setExportOpen(false)} />
        )}

        {batchOpen && inMake && (
          <BatchExportPanel imageData={getCurrentImage()} onClose={() => setBatchOpen(false)} />
        )}

        <footer className="lab-foot">
          {appMode === 'make' && '制作：出图为主路径'}
          {appMode === 'play' && '玩法：离开模式会丢弃未固化的实时效果'}
          {appMode === 'learn' && '原理：载入图 → ①②③ → 按住对照'}
        </footer>
      </aside>

      <LibraryDrawer
        open={libraryOpen}
        onClose={() => {
          setLibraryOpen(false);
          void refreshLibraryCount();
        }}
        onPick={pickFromLibrary}
        getCurrentImage={getCurrentImage}
        currentLibraryId={currentLibraryId}
      />
    </div>
  );
}
